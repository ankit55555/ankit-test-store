{%- comment -%}
  Line icons for the backdrop configurator.
  Accepts:
  - icon: {String} icon name
{%- endcomment -%}
<svg
  class="bds-icon bds-icon--{{ icon }}"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="10"/><path d="M7.5 12.5l3 3 6-6.5"/>
    {%- when 'ruler' -%}
      <path d="M3 17.5L17.5 3 21 6.5 6.5 21z"/><path d="M7 13.5l2 2M10 10.5l1.5 1.5M13 7.5l2 2"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'info' -%}
      <circle cx="12" cy="12" r="10"/><path d="M12 11v5M12 8h.01"/>
    {%- when 'upload' -%}
      <path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 001 1h14a1 1 0 001-1v-3"/>
    {%- when 'brush' -%}
      <path d="M18.4 2.6a2 2 0 012.9 2.9L11 15.8 8.2 13z"/><path d="M8 13.5c-2.2 0-3.5 1.6-3.5 3.5 0 1.5-1 2.5-2.5 3 4 1 8.5.5 8.5-3.8"/>
    {%- when 'cloud' -%}
      <path d="M7 18a4.5 4.5 0 01-.6-8.96A6 6 0 0118 8a4.5 4.5 0 01-.5 10"/><path d="M12 12v8M9 15l3-3 3 3"/>
    {%- when 'file' -%}
      <path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'truck' -%}
      <path d="M2 6h11v10H2zM13 10h4l4 4v2h-8z"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
    {%- when 'shield' -%}
      <path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
    {%- when 'refresh' -%}
      <path d="M20 11a8 8 0 00-14.3-4.9L4 8M4 4v4h4M4 13a8 8 0 0014.3 4.9L20 16M20 20v-4h-4"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
  {%- endcase -%}
</svg>
