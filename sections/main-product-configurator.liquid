    { "type": "text", "id": "frame_2_title", "label": "Option 2 title", "default": "Print only, no frame" },
    { "type": "text", "id": "frame_2_text", "label": "Option 2 text", "default": "Replacement fabric for a frame you own." },
    { "type": "header", "content": "Artwork" },
    { "type": "text", "id": "design_reply_time", "label": "Design review reply time", "default": "about 2 hours" },
    { "type": "text", "id": "design_mockup_time", "label": "Mock-up time", "default": "24 hours" },
    { "type": "header", "content": "Summary" },
    {
      "type": "text",
      "id": "production_text",
      "label": "Production text",
      "default": "Printed within 24 business hours of artwork approval"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery text",
      "default": "Free delivery in 5–7 business days across the US"
    },
    { "type": "text", "id": "trust_1", "label": "Trust item 1", "default": "1-year warranty" },
    { "type": "text", "id": "trust_2", "label": "Trust item 2", "default": "Free shipping" },
    { "type": "text", "id": "trust_3", "label": "Trust item 3", "default": "Print it right or we reprint" },
    { "type": "header", "content": "Section padding" },
