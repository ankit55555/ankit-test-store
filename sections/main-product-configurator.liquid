    { "type": "text", "id": "print_2_title", "label": "Option 2 title", "default": "Double-sided" },
    { "type": "text", "id": "print_2_text", "label": "Option 2 text", "default": "Graphic on both sides. Best for open spaces." },
    { "type": "text", "id": "print_3_title", "label": "Option 3 title", "default": "Frame only" },
