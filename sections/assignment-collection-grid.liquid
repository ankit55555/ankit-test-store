{{ 'component-assignment-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'assignment-product-card.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign target_collection = section.settings.collection
  if target_collection == blank and collection != blank
    assign target_collection = collection
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="AssignmentCollectionGrid-{{ section.id }}"
  class="assignment-collection-grid section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="assignment-collection-grid__header">
        <h2 class="assignment-collection-grid__heading">{{ section.settings.heading | escape }}</h2>
      </header>
    {%- endif -%}

    {%- if target_collection != blank and target_collection.products_count > 0 -%}
      <ul
        class="assignment-collection-grid__list assignment-collection-grid__list--{{ section.settings.columns_desktop }}"
        role="list"
      >
        {%- for product in target_collection.products limit: section.settings.products_to_show -%}
          <li class="assignment-collection-grid__item">
            {% render 'card-product-assignment',
              card_product: product,
              section_id: section.id,
              skip_styles: true
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="assignment-collection-grid__empty">
        {{ section.settings.empty_message | escape }}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Assignment Grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "6"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty collection message",
      "default": "Choose a collection with products to preview this grid."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-8"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Assignment Grid",
      "settings": {
        "heading": "Best sellers",
        "products_to_show": 6,
        "columns_desktop": "6"
      }
    }
  ]
}
{% endschema %}
